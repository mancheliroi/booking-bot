# Токен от @BotFather
BOT_TOKEN=123456789:ABCdefYourTokenHere
# Telegram ID главного разработчика (узнать свой: @userinfobot).
# Он управляет компаниями через /companies, но услуги/тексты каждой
# компании правит её собственный владелец через /admin.
ADMIN_IDS=[123456789]

# SQLite по умолчанию; для PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://bot:bot@db:5432/bot
DATABASE_URL=sqlite+aiosqlite:///./data/bookings.db

# Значения по умолчанию для новой компании — дальше владелец меняет их
# себе под расписание через /admin → «⏰ Расписание»
TIMEZONE=Europe/Moscow
WORK_START_HOUR=10
WORK_END_HOUR=20
SLOT_MINUTES=60
DAYS_AHEAD=7
# Выходные: 0 — пн ... 6 — вс
DAYS_OFF=[6]

# Сколько минут держим слот, пока клиент не оплатит (для компаний с предоплатой)
PAYMENT_HOLD_MINUTES=15
